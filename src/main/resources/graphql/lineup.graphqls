scalar JSON

type Performer {
  id: ID!
  name: JSON!
  description: JSON!
  imageUrl: String!
  isActive: Boolean!
  isFavorited: Boolean!
  stageNames: [JSON]
  createdAt: String
  updatedAt: String
}

type Stage {
  id: ID!
  name: JSON!
  locationDesc: JSON!
  displayOrder: Int!
}

type FestivalDay {
  id: ID!
  dayNumber: Int!
  eventDate: String!
}

type PerformanceDuration {
  durationMinutes: Int!
  durationLabel: String!
}

type ArtistSchedule {
  scheduleId: ID!
  performer: Performer!
  startAt: String!
  endAt: String!
  status: ScheduleStatus!
  duration: PerformanceDuration!
}

type StageSchedule {
  stage: Stage!
  artists: [ArtistSchedule!]!
}

type Favorite {
  id: ID!
  performerId: ID!
  createdAt: String
}

enum ScheduleStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

extend type Query {
  "공연자 목록 조회 (활성 상태, 스테이지별 필터링 가능)"
  performers(activeOnly: Boolean, stageId: ID, locale: String): [Performer!]!
  "특정 일자의 공연 타임테이블 조회 (스테이지별 필터링 가능)"
  schedulesByDay(dayId: ID!, stageId: ID, locale: String): [StageSchedule!]!
  "내가 즐겨찾기한 공연자 목록 조회"
  myFavorites: [Performer!]!
  "페스티벌 일자 목록 조회"
  festivalDays: [FestivalDay!]!
}

extend type Mutation {
  "공연자 즐겨찾기 추가"
  addFavorite(performerId: ID!): Favorite!
  "공연자 즐겨찾기 삭제"
  removeFavorite(performerId: ID!): Boolean!
}
