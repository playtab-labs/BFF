# ── Stamp Tour ──

type StampSpot {
  spotId: ID!
  spotName: String!
  spotDescription: String!
  visited: Boolean!
  visitedAt: String
}

type MyStampsResponse {
  totalCount: Int!
  visitedCount: Int!
  spots: [StampSpot!]!
}

extend type Query {
  "내 스탬프 투어 현황 조회 (전체 스팟 수, 방문 수, 스팟별 방문 여부)"
  myStamps: MyStampsResponse!
}
